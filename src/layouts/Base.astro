---
import { localePath, locales, type Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={localePath[l]} />)}
    <link rel="alternate" hreflang="x-default" href={localePath.es} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
