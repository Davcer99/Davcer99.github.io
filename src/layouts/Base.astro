---
import "@fontsource/atkinson-hyperlegible/latin-400.css";
import "@fontsource/atkinson-hyperlegible/latin-700.css";
import "../styles/global.css";
import { localePath, locales, type Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
// Search engines expect fully qualified hreflang URLs.
const absolute = (path: string) => new URL(path, Astro.site).href;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={absolute(localePath[l])} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(localePath.es)} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
